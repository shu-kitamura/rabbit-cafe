---
import BrandMark from './BrandMark.astro';
import type { BrandContent, HeaderCtaContent, NavItem } from '../consts/landing-page';

interface Props {
	brand: BrandContent;
	navItems: readonly NavItem[];
	cta: HeaderCtaContent;
}

const { brand, navItems, cta } = Astro.props;
---

<header class="site-header">
	<a class="brand" href="#top" aria-label={brand.backToTopLabel}>
		<BrandMark />
		<span class="brand-text">{brand.name}</span>
	</a>

	<nav class="site-nav" aria-label="サイト内ナビゲーション">
		<ul>
			{
				navItems.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
