---
import type { ExperienceContent } from '../consts/landing-page';

interface Props {
	experience: ExperienceContent;
}

const { experience } = Astro.props;
const activeBunny = experience.bunnies[experience.activeIndex];
const experienceTitle = experience.titleLines.join('\n');
const experienceCopy = experience.copyLines.join('\n');
---

<section class="section section-experience" id={experience.id}>
	<div class="experience-copy">
		<p class="eyebrow">{experience.eyebrow}</p>
		<h2 class="experience-title">{experienceTitle}</h2>
		<p class="section-copy experience-summary">{experienceCopy}</p>
	</div>

	<div class="photo-panel bunny-carousel" aria-label="今日会えるうさぎカルーセル">
		<p class="photo-label">
			{experience.carouselLabel} {experience.activeIndex + 1} / {experience.bunnies.length}
		</p>
		<div class="carousel-stage" aria-hidden="true"></div>

		<div class="carousel-footer">
			<div class="carousel-meta">
				<h3>
					{activeBunny.name} / {activeBunny.age}
				</h3>
				<p>{activeBunny.summary}</p>
			</div>
			<div class="carousel-controls" aria-hidden="true">
				<span class="carousel-control">‹</span>
				<span class="carousel-control">›</span>
			</div>
		</div>

		<div class="carousel-dots" aria-hidden="true">
			{
				experience.bunnies.map((_, index) => (
					<span class={`carousel-dot ${index === experience.activeIndex ? 'is-active' : ''}`}></span>
				))
			}
		</div>
	</div>
</section>
