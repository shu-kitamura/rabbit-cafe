---
import { Image } from 'astro:assets';
import type { HeroContent } from '../consts/landing-page';

interface Props {
	hero: HeroContent;
}

const { hero } = Astro.props;
---

<section class="hero">
	<div class="hero-copy">
		<p class="eyebrow">{hero.eyebrow}</p>
		<h1>
			{hero.titleLines[0]}
			<br />
			{hero.titleLines[1]}
		</h1>
		<p class="hero-lead">
			{hero.leadLines[0]}
			<br />
			{hero.leadLines[1]}
		</p>
		<div class="hero-actions">
			<a class="button button-primary" href={hero.primaryCta.href}>
				{hero.primaryCta.label}
			</a>
			<a class="button button-secondary" href={hero.secondaryCta.href}>
				{hero.secondaryCta.label}
			</a>
		</div>
	</div>

	<div class="hero-visual" aria-labelledby="hero-visual-copy">
		<div class="visual-stage">
			<Image
				class="hero-photo"
				src={hero.visualImage}
				alt={hero.visualAlt}
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>
