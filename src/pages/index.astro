---
import { landingPageContent } from '../consts/landing-page';
import Layout from '../layouts/Layout.astro';
import '../styles/landing-page.css';

const heroChipClasses = ['chip-left', 'chip-center', 'chip-right'];
---

<Layout
	title={landingPageContent.meta.title}
	description={landingPageContent.meta.description}
>
	<main class="landing-page" id="top">
		<header class="site-header">
			<a
				class="brand"
				href="#top"
				aria-label={landingPageContent.brand.backToTopLabel}
			>
				<span class="brand-mark" aria-hidden="true"></span>
				<span class="brand-text">{landingPageContent.brand.name}</span>
			</a>

			<nav class="site-nav" aria-label="サイト内ナビゲーション">
				<ul>
					{
						landingPageContent.navItems.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<a class="header-cta" href={landingPageContent.headerCta.href}>
				{landingPageContent.headerCta.label}
			</a>
		</header>

		<section class="hero">
			<div class="hero-copy">
				<p class="eyebrow">{landingPageContent.hero.eyebrow}</p>
				<h1>
					{landingPageContent.hero.titleLines[0]}
					<br />
					{landingPageContent.hero.titleLines[1]}
				</h1>
				<p class="hero-lead">
					{landingPageContent.hero.leadLines[0]}
					<br />
					{landingPageContent.hero.leadLines[1]}
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href={landingPageContent.hero.primaryCta.href}>
						{landingPageContent.hero.primaryCta.label}
					</a>
					<a class="button button-secondary" href={landingPageContent.hero.secondaryCta.href}>
						{landingPageContent.hero.secondaryCta.label}
					</a>
				</div>
			</div>

			<div class="hero-visual" aria-labelledby="hero-visual-copy">
				<p class="visual-caption" id="hero-visual-copy">
					{landingPageContent.hero.visualCaption}
				</p>
				<div class="visual-stage">
					<div class="window-glow" aria-hidden="true"></div>
					<div class="table-surface" aria-hidden="true"></div>
					<div class="bunny bunny-left" aria-hidden="true"></div>
					<div class="bunny bunny-right" aria-hidden="true"></div>
					{
						landingPageContent.hero.visualChips.map((chip, index) => (
							<div class={`visual-chip ${heroChipClasses[index]}`}>{chip}</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="section section-concept">
			<p class="eyebrow">{landingPageContent.concept.eyebrow}</p>
			<h2>
				{landingPageContent.concept.titleLines[0]}
				<br />
				{landingPageContent.concept.titleLines[1]}
			</h2>
			<p class="section-copy">
				{landingPageContent.concept.copyLines[0]}
				<br />
				{landingPageContent.concept.copyLines[1]}
			</p>

			<div class="card-grid">
				{
					landingPageContent.concept.cards.map((card) => (
						<article class={`info-card ${card.tone}`}>
							<h3>{card.title}</h3>
							<p>{card.body}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="section section-menu" id={landingPageContent.menu.id}>
			<p class="eyebrow">{landingPageContent.menu.eyebrow}</p>
			<h2>
				{landingPageContent.menu.titleLines[0]}
				<br />
				{landingPageContent.menu.titleLines[1]}
			</h2>

			<div class="card-grid">
				{
					landingPageContent.menu.cards.map((card) => (
						<article class={`info-card ${card.tone}`}>
							<div class="menu-illustration" aria-hidden="true"></div>
							<h3>{card.title}</h3>
							<p>{card.body}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="section section-experience" id={landingPageContent.experience.id}>
			<div class="photo-panel">
				<p class="photo-label">{landingPageContent.experience.photoLabel}</p>
				<div class="photo-scene" aria-hidden="true">
					<div class="photo-card photo-card-large"></div>
					<div class="photo-card photo-card-small"></div>
				</div>
			</div>

			<div class="experience-copy">
				<p class="eyebrow">{landingPageContent.experience.eyebrow}</p>
				<h2>
					{landingPageContent.experience.titleLines[0]}
					<br />
					{landingPageContent.experience.titleLines[1]}
					<br />
					{landingPageContent.experience.titleLines[2]}
				</h2>
				<p class="section-copy">
					{landingPageContent.experience.copyLines[0]}
					<br />
					{landingPageContent.experience.copyLines[1]}
				</p>

				<div class="visit-flow" aria-label="来店の流れ">
					{
						landingPageContent.experience.visitSteps.map((step, index) => (
							<span class="visit-pill">
								<small>{index + 1}</small>
								{step}
							</span>
						))
					}
				</div>

				<div class="support-note">{landingPageContent.experience.supportNote}</div>
			</div>
		</section>

		<section class="section section-access" id={landingPageContent.access.id}>
			<div class="access-copy">
				<p class="eyebrow">{landingPageContent.access.eyebrow}</p>
				<h2>
					{landingPageContent.access.titleLines[0]}
					<br />
					{landingPageContent.access.titleLines[1]}
				</h2>
				<p class="section-copy">
					{landingPageContent.access.copyLines[0]}
					<br />
					{landingPageContent.access.copyLines[1]}
				</p>

				<div class="map-card">
					<p>{landingPageContent.access.mapTitle}</p>
					<ul>
						{
							landingPageContent.access.notes.map((note) => (
								<li>{note}</li>
							))
						}
					</ul>
				</div>
			</div>

			<aside class="reservation-card">
				<h2>
					{landingPageContent.reservation.titleLines[0]}
					<br />
					{landingPageContent.reservation.titleLines[1]}
				</h2>
				<p>
					{landingPageContent.reservation.copyLines[0]}
					<br />
					{landingPageContent.reservation.copyLines[1]}
				</p>

				<form class="reservation-form">
					<label>
						<span>{landingPageContent.reservation.fields.dateLabel}</span>
						<input
							type="text"
							name="date"
							value={landingPageContent.reservation.fields.defaultDate}
						/>
					</label>
					<label>
						<span>{landingPageContent.reservation.fields.guestLabel}</span>
						<select name="guests">
							{
								landingPageContent.reservation.fields.guestOptions.map((option) => (
									<option>{option}</option>
								))
							}
						</select>
					</label>
					<button class="button button-primary" type="button">
						{landingPageContent.reservation.buttonLabel}
					</button>
				</form>
			</aside>
		</section>

		<footer class="site-footer" id={landingPageContent.footer.id}>
			<div class="footer-brand">
				<a
					class="brand footer-brand-link"
					href="#top"
					aria-label={landingPageContent.brand.backToTopLabel}
				>
					<span class="brand-mark" aria-hidden="true"></span>
					<span class="brand-text">{landingPageContent.brand.name}</span>
				</a>
				<p>
					{landingPageContent.footer.descriptionLines[0]}
					<br />
					{landingPageContent.footer.descriptionLines[1]}
				</p>
			</div>

			<nav class="footer-links" aria-label="フッターナビゲーション">
				{
					landingPageContent.footer.links.map((item) => (
						<a href={item.href}>{item.label}</a>
					))
				}
			</nav>

			<div class="footer-meta">
				{
					landingPageContent.footer.metaLines.map((line) => (
						<p>{line}</p>
					))
				}
			</div>
		</footer>
	</main>
</Layout>
