---
import LandingAccessSection from '../components/LandingAccessSection.astro';
import LandingConceptSection from '../components/LandingConceptSection.astro';
import LandingExperienceSection from '../components/LandingExperienceSection.astro';
import LandingFooter from '../components/LandingFooter.astro';
import LandingHeader from '../components/LandingHeader.astro';
import LandingHeroSection from '../components/LandingHeroSection.astro';
import LandingMenuSection from '../components/LandingMenuSection.astro';
import { landingPageContent } from '../consts/landing-page';
import Layout from '../layouts/Layout.astro';
import '../styles/landing-page.css';
---

<Layout
	title={landingPageContent.meta.title}
	description={landingPageContent.meta.description}
>
	<main class="landing-page" id="top">
		<LandingHeader
			brand={landingPageContent.brand}
			navItems={landingPageContent.navItems}
			cta={landingPageContent.headerCta}
		/>
		<LandingHeroSection hero={landingPageContent.hero} />
		<LandingConceptSection concept={landingPageContent.concept} />
		<LandingMenuSection menu={landingPageContent.menu} />
		<LandingExperienceSection experience={landingPageContent.experience} />
		<LandingAccessSection
			access={landingPageContent.access}
			reservation={landingPageContent.reservation}
		/>
		<LandingFooter
			brand={landingPageContent.brand}
			footer={landingPageContent.footer}
		/>
	</main>
</Layout>
